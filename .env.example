# Public — safe to expose to the browser
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server only. Never prefix with NEXT_PUBLIC_ — it would be inlined into the
# client bundle and shipped to every visitor.
SANITY_API_READ_TOKEN=

# Shared with the Sanity webhook that triggers on-demand revalidation.
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# The domain this deploy is served from, without a trailing slash. Drives the
# sitemap, robots.txt, metadataBase and og:url. Defaults to the production
# site, so a staging deploy must set it.
NEXT_PUBLIC_SITE_URL=https://herbamojo.id

# Set to "true" on staging or preview deploys to keep them out of search
# results. Leave unset in production.
NEXT_PUBLIC_NOINDEX=

